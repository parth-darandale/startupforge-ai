{
  "$defs": {
    "IdeaSpec": {
      "additionalProperties": false,
      "properties": {
        "original_text": {
          "maxLength": 12000,
          "minLength": 10,
          "title": "Original Text",
          "type": "string"
        },
        "project_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "problem": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Problem",
          "type": "string"
        },
        "solution": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Solution",
          "type": "string"
        },
        "target_users": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Target Users",
          "type": "array"
        },
        "domain": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Assumptions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Constraints",
          "type": "array"
        },
        "field_origins": {
          "additionalProperties": {
            "enum": [
              "provided",
              "inferred",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Field Origins",
          "type": "object"
        }
      },
      "required": [
        "original_text",
        "project_name",
        "problem",
        "solution",
        "domain"
      ],
      "title": "IdeaSpec",
      "type": "object"
    },
    "ResearchOptions": {
      "additionalProperties": false,
      "properties": {
        "max_sources": {
          "default": 5,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Sources",
          "type": "integer"
        },
        "language": {
          "default": "en",
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Source Urls",
          "type": "array"
        }
      },
      "title": "ResearchOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "idea": {
      "$ref": "#/$defs/IdeaSpec"
    },
    "research_options": {
      "$ref": "#/$defs/ResearchOptions"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    }
  },
  "required": [
    "project_id",
    "idea"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
