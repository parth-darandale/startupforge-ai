# Demo mode works without credentials and uses clearly labelled fixture sources.
APP_MODE=demo
DATABASE_PATH=data/intelligence.sqlite3

# To use a real model: APP_MODE=live and configure either provider below.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_RESPONSE_FORMAT=json_schema

# Keyless local model option: LLM_PROVIDER=ollama, set LLM_MODEL to a model
# already installed in your local Ollama instance.
# Project shortlist: qwen3:4b-instruct-2507-q4_K_M (default), or
# startupforge-fin-r1 (claim-revision alternative). See integration/model_trials/RESULTS.md.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context capacity must cover the research evidence, debate history and output.
# Keep 4096 for older Llama 2 models; newer models can use a larger supported value.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2
# A short idle lifetime keeps only the currently used local model resident.
# Use 0 to unload immediately after each request; accepted range is 0 to 1h.
OLLAMA_KEEP_ALIVE=5m
# default omits the toggle for compatibility. Use false for Qwen3 after checking
# /api/show supports it; models with mandatory thinking may require default.
OLLAMA_THINK=default
# Preflight estimate: UTF-8 prompt bytes / ratio, plus 128 template tokens and
# the full output limit, must fit NUM_CTX. This is not an exact tokenizer count.
# Smaller ratios are more conservative; values must be >0 and <=4. Oversized
# prompts fail explicitly without clipping the idea, evidence or conversation.
OLLAMA_CONTEXT_BYTES_PER_TOKEN=3

# Keyless options: wikipedia for background introductions, duckduckgo for search
# snippets. DuckDuckGo Lite is an HTML site rather than a stable search API;
# challenges or markup changes fail explicitly. It never fetches destination
# articles. Verify statistics in the full publication before relying on them.
# crossref provides deposited scholarly abstracts and metadata from its public
# API. It does not fetch full publications or guarantee current market data,
# regional applicability or requested language coverage. It needs no API key.
# Tavily needs a separate key and can retrieve extracted publication text.
# web discovers publisher URLs using explicitly selected public search engines,
# then downloads full public HTML or text-based PDF passages with Trafilatura/
# pypdf. Supplied research_options.source_urls bypass discovery. Robots
# exclusions and inaccessible pages become visible gaps. Keyless search depends
# on service access; Bing News RSS remains available as a news-only option.
SEARCH_PROVIDER=wikipedia
TAVILY_API_KEY=
WEB_DISCOVERY_PROVIDER=ddgs
WEB_SEARCH_ENGINES=yahoo,duckduckgo
WEB_SEARCH_REGION=in-en
WEB_REQUEST_TIMEOUT=15

# Keyword retrieval is a baseline, not semantic embeddings.
# Install requirements-semantic.txt and select fastembed for semantic retrieval.
RETRIEVAL_PROVIDER=keyword
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PROVIDER_TIMEOUT=90
